# Variables consumed by docker-compose.yml at the repo root.
# Copy to .env and fill in real values for a production deploy.
# Local dev works fine without this file — every var has a safe default.

POSTGRES_PASSWORD=authpassword
JWT_SECRET=dev-jwt-secret-change-in-production
JWT_REFRESH_SECRET=dev-jwt-refresh-secret-change-in-production

# Public origin of the deployed frontend, used for CORS on both services.
CORS_ORIGIN=http://localhost:3000

# Host port the web container's nginx (port 80) is published on.
# Set to 80 on a VPS that should be reachable on the bare domain/IP.
WEB_PORT=3000
